# ============================================================
# DevReport - Environment Variables
# ============================================================
# Copy this file to .env and fill in your credentials
# NEVER commit the .env file!
# ============================================================

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=IA-para-DEVs-SCTEC-T2
GITHUB_REPO=mini-projeto-modulo2-devreport
GITHUB_PROJECT=7
GITHUB_ASSIGNEE=thiagocaandrade

# Mock mode - set to true to use local mock-issues.json instead of GitHub API
MOCK_MODE=true

# DeepSeek AI Configuration (OpenAI-compatible API)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
